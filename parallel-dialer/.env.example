# ─────────────────────────────────────────────────────────────────────────────
# Parallel Dialer — environment configuration
# Copy to `.env` and fill in. Never commit the populated file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public HTTPS origin Twilio can reach (ngrok/Cloudflare tunnel in dev).
# Used to build TwiML callback URLs and the wss:// Media Stream URL.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# Comma-separated origins allowed to call the JSON API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Shared secret the agent UI sends as `x-dialer-key` on control endpoints.
# Replace with real auth before exposing this service to the internet.
DIALER_API_KEY=change-me-local-dev-only

# ── Twilio: REST + outbound calling ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Caller ID for outbound legs. Must be a Twilio number or verified caller ID.
TWILIO_CALLER_ID=+13055550123

# Optional: validate inbound TwiML webhooks against Twilio's signature.
TWILIO_VALIDATE_SIGNATURE=true

# ── Twilio: WebRTC (Voice SDK access tokens) ─────────────────────────────────
# API Key/Secret pair from Console → Account → API keys & tokens.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret

# TwiML App SID whose Voice Request URL points at POST {PUBLIC_BASE_URL}/twiml/agent-outbound
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Access token lifetime in seconds (max 86400).
TWILIO_TOKEN_TTL_SECONDS=3600

# ── Deepgram: streaming speech-to-text used for answer detection ─────────────
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2-phonecall
# Silence (ms) Deepgram waits before finalizing an utterance. Lower = faster.
DEEPGRAM_ENDPOINTING_MS=300

# ── Answer Machine Detection (AMD) state machine tuning ──────────────────────
# Dead air after answer before the leg is written off as machine/no-answer.
AMD_INITIAL_SPEECH_TIMEOUT_MS=3800
# Unbroken speech block that marks the leg as a voicemail greeting.
AMD_MAX_CONTINUOUS_SPEECH_MS=2800
# Hard ceiling: classify no matter what once this elapses.
AMD_DECISION_DEADLINE_MS=9000

# ── Parallel dialing ─────────────────────────────────────────────────────────
# Lines opened per agent per batch. Keep 3–5; higher risks abandoned calls.
DIALER_BATCH_SIZE=4
# Seconds Twilio rings an unanswered leg before giving up.
DIALER_RING_TIMEOUT_SECONDS=22
# Agent client identity used in <Dial><Client>. Must match the token identity.
DIALER_AGENT_IDENTITY=agent_1

# ── HubSpot ──────────────────────────────────────────────────────────────────
# Private app token (pat-...) with crm.objects.contacts + crm.objects.calls scopes.
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# App client secret — required for x-hubspot-signature-v3 validation.
HUBSPOT_CLIENT_SECRET=your_hubspot_app_client_secret
# Reject webhook requests whose timestamp is older than this (HubSpot spec: 5 min).
HUBSPOT_SIGNATURE_MAX_AGE_MS=300000
# Lead webhook fan-in throttle: leads promoted into dial batches concurrently.
HUBSPOT_QUEUE_CONCURRENCY=2
