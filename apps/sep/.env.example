# ---------------------------------------------------------------------------
# Automate305 SEP — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma Migrate and the runtime adapter.
DATABASE_URL="postgresql://sep:sep@localhost:5432/sep?schema=public"

# Redis connection used by BullMQ for the send queue and reply polling.
REDIS_URL="redis://localhost:6379"

# Public origin of this app. Used to build absolute tracking-pixel URLs, so it
# must be reachable by the recipient's mail client.
APP_URL="http://localhost:3000"

# How many send jobs a single worker process handles at once.
EMAIL_WORKER_CONCURRENCY="5"

# Minutes between IMAP inbox polls for reply detection.
REPLY_POLL_MINUTES="2"
