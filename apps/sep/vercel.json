{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "crons": [
    { "path": "/api/cron/dispatch", "schedule": "0 13 * * *" },
    { "path": "/api/cron/poll-replies", "schedule": "0 14 * * *" }
  ]
}
