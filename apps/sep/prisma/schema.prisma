// Automate305 Sales Engagement Platform — data model.
//
// Entity hierarchy:
//   Campaign 1─┬─* SequenceStep   (ordered steps, delayDays apart)
//              ├─* Lead           (recipients, status-gated)
//              └─* EmailLog       (one row per dispatched send)
//   SendingAccount 1─* Campaign / EmailLog (SMTP + IMAP mailbox, daily cap)

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

// Prisma 7 moved connection URLs out of the schema: migrations read the URL from
// prisma.config.ts, and the runtime client is constructed with a driver adapter
// (see lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum LeadStatus {
  UNCONTACTED
  IN_SEQUENCE
  REPLIED
  OPTED_OUT
  // Undeliverable. Distinct from OPTED_OUT: the recipient did not ask to leave.
  BOUNCED
}

enum SuppressionReason {
  HARD_BOUNCE
  REPEATED_SOFT_BOUNCE
  COMPLAINT
  MANUAL
}

enum EmailStatus {
  SENT
  OPENED
  BOUNCED
  FAILED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)

  // Mailbox used to dispatch this campaign. Nullable so a DRAFT can exist first.
  sendingAccountId String?
  sendingAccount   SendingAccount? @relation(fields: [sendingAccountId], references: [id], onDelete: SetNull)

  steps     SequenceStep[]
  leads     Lead[]
  emailLogs EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sendingAccountId])
}

model SequenceStep {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // 1-based position in the sequence.
  stepOrder Int
  // Days to wait after the previous step before this one is eligible to send.
  delayDays Int @default(0)

  // Both support template tags: {{firstName}}, {{lastName}}, {{company}}, {{email}}.
  subject String
  body    String

  emailLogs EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, stepOrder])
  @@index([campaignId])
}

model Lead {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  email     String
  firstName String?
  lastName  String?
  company   String?
  // Any extra CSV columns preserved verbatim for template substitution.
  customFields Json?

  status LeadStatus @default(UNCONTACTED)

  // Opaque token behind the unsubscribe link and the RFC 8058 headers.
  unsubscribeToken String @unique @default(cuid())

  // Highest stepOrder already delivered. 0 means nothing sent yet.
  currentStep Int       @default(0)
  // When the next step becomes eligible. Null once the sequence is exhausted.
  nextSendAt  DateTime?

  lastContactedAt DateTime?
  repliedAt       DateTime?
  optedOutAt      DateTime?
  bouncedAt       DateTime?

  // Temporary failures seen for this lead. Suppression follows at the limit.
  softBounceCount Int @default(0)

  emailLogs EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([status, nextSendAt])
  @@index([email])
}

model SendingAccount {
  id        String @id @default(cuid())
  name      String
  fromName  String
  fromEmail String @unique

  smtpHost     String
  smtpPort     Int     @default(587)
  smtpSecure   Boolean @default(false)
  smtpUser     String
  smtpPassword String

  imapHost     String?
  imapPort     Int?    @default(993)
  imapSecure   Boolean @default(true)
  imapUser     String?
  imapPassword String?

  // Per-mailbox throttle. sentToday resets when lastResetAt rolls to a new UTC day.
  maxDaily    Int      @default(50)
  sentToday   Int      @default(0)
  lastResetAt DateTime @default(now())

  // Sending window, in this mailbox's own timezone. Cold email landing at 03:00
  // reads as automated, so sends are confined to working hours.
  timezone            String @default("America/New_York")
  sendWindowStartHour Int    @default(8)
  sendWindowEndHour   Int    @default(17)
  /// ISO weekdays, 1 = Monday through 7 = Sunday. Defaults to weekdays.
  sendDays            Int[]  @default([1, 2, 3, 4, 5])
  /// Random spread applied to each scheduled step, so sends do not leave in a burst.
  jitterMinutes       Int    @default(45)

  // Warmup ramp. A new mailbox opening at full volume is a spam-filter signal.
  warmupEnabled        Boolean   @default(false)
  warmupStartedAt      DateTime?
  warmupInitialDaily   Int       @default(5)
  warmupDailyIncrement Int       @default(5)

  isActive Boolean @default(true)

  campaigns Campaign[]
  emailLogs EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model EmailLog {
  id String @id @default(cuid())

  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  sequenceStepId String?
  sequenceStep   SequenceStep? @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)

  sendingAccountId String?
  sendingAccount   SendingAccount? @relation(fields: [sendingAccountId], references: [id], onDelete: SetNull)

  status  EmailStatus @default(SENT)
  subject String
  stepOrder Int       @default(1)

  // SMTP Message-ID, used by the reply worker to thread inbound mail.
  messageId String? @unique
  // Opaque id embedded in the tracking pixel URL.
  trackingId String @unique

  sentAt    DateTime  @default(now())
  openedAt  DateTime?
  openCount Int       @default(0)
  error     String?

  createdAt DateTime @default(now())

  @@index([campaignId, status])
  @@index([leadId])
  @@index([sentAt])
}

/// Addresses that must never be emailed again, keyed on the address rather than
/// the lead, because the same person can appear in several campaigns.
model SuppressedAddress {
  id     String            @id @default(cuid())
  email  String            @unique
  reason SuppressionReason
  detail String?

  // How many times this address has been reported undeliverable.
  bounceCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reason])
}
